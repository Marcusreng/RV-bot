# Rejsefilter (inklusive datoer)
TARGET_START=2026-12-01
TARGET_END=2027-01-31
MIN_CAPACITY=3

# Gmail SMTP. Brug en app-adgangskode, ikke din normale Google-adgangskode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=din-email@gmail.com
SMTP_PASSWORD=din-16-tegns-app-adgangskode
EMAIL_FROM=din-email@gmail.com
EMAIL_TO=modtager@gmail.com

# Valgfrit
STATE_FILE=.state/seen.json
NOTIFY_EXISTING_ON_FIRST_RUN=true
REQUEST_TIMEOUT=30
ORIGIN_TERMS=los angeles,carson,santa fe springs,agoura hills
DESTINATION_TERMS=new york,linden,newark,kenvil
